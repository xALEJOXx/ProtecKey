# ProtecKey - Configuracion de ejemplo
# Copiar este archivo como .env
# Reemplazar todos los valores antes de iniciar Docker.
# No compartir el archivo .env generado.

POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA

# Token para autenticar el envio de trafico del monitor.
LIVE_MONITOR_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO

# Token para proteger las consultas del historial ML.
LIVE_HISTORY_TOKEN=REEMPLAZAR_CON_OTRO_TOKEN_ALEATORIO
